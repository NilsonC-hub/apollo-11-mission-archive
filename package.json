{
  "name": "apollo-11-mission-archive",
  "private": true,
  "version": "0.0.0-phase5",
  "type": "module",
  "description": "Apollo 11 Mission Archive + Historical Replay — a verifiable digital archive and MET-driven historical replay of AS-506.",
  "scripts": {
    "dev": "pnpm stage:runtime-assets && vite",
    "build": "pnpm stage:runtime-assets && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test --experimental-strip-types tests/unit/**/*.test.ts",
    "validate:sources": "node --experimental-strip-types scripts/validate-sources.ts",
    "validate:mission": "node --experimental-strip-types scripts/validate-mission.ts",
    "validate:models": "node --experimental-strip-types scripts/validate-models.ts",
    "inspect-glb": "node --experimental-strip-types scripts/inspect-glb.ts",
    "inspect-stls": "node --experimental-strip-types scripts/inspect-stls.ts",
    "hydrate-assets": "node --experimental-strip-types scripts/hydrate-assets.ts",
    "bootstrap:ktx": "node --experimental-strip-types scripts/bootstrap-ktx.ts",
    "optimize:models": "node --experimental-strip-types scripts/optimize-models.ts",
    "optimize:textures": "node --experimental-strip-types scripts/prepare-textures.ts",
    "stage:decoders": "node --experimental-strip-types scripts/stage-decoders.ts",
    "validate:decoders": "node --experimental-strip-types scripts/validate-decoders.ts",
    "stage:runtime-assets": "node --experimental-strip-types scripts/stage-runtime-assets.ts"
  },
  "packageManager": "pnpm@10.6.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/extensions": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "draco3d": "1.5.7",
    "draco3dgltf": "1.5.7",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4"
  },
  "dependencies": {
    "@react-three/fiber": "9.6.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.1",
    "three": "0.185.1",
    "zustand": "5.0.14"
  }
}
